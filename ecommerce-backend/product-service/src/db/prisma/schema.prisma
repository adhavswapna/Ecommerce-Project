generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String         @id @default(cuid())
  vendorId    String
  name        String
  price       Float
  createdAt   DateTime       @default(now())
  description String?
  stock       Int
  updatedAt   DateTime       @updatedAt
  priceRange  String?
  images      ProductImage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  productId String
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}
