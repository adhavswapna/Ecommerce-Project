generator client {
  provider = "prisma-client-js"
}

// ✅ DATABASE CONNECTION
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ✅ MODEL
model Refund {
  id        String       @id @default(cuid())   // ✅ FIXED
  orderId   String
  userId    String
  paymentId String
  amount    Float
  reason    String
  status    RefundStatus @default(REQUESTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
}

// ✅ ENUM
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  COMPLETED
}
