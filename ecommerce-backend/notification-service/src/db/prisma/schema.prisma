generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENDOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(USER)

  name      String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
