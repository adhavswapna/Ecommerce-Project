generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuthUser {
  id        String   @id @default(uuid())

  // Profile
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)

  phone     String?
  address   String?

  // Account status
  isVerified Boolean @default(false)

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum Role {
  USER
  VENDOR
  ADMIN
}

