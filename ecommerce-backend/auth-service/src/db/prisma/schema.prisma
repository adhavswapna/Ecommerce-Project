generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuthUser {
  id        String   @id @default(uuid())

  // Profile
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)

  phone     String?
  address   String?

  // Account status
  // Used for email/account verification.
  // This is NOT vendor admin approval.
  isVerified Boolean @default(false)

  // Vendor approval status
  // Only meaningful when role = VENDOR.
  // USER and ADMIN accounts can leave this as null.
  vendorStatus VendorStatus?

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([vendorStatus])
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}
