datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shipment {
  id         String   @id @default(uuid())
  orderId    String   @unique
  userId     String
  address    String
  trackingId String
  status     String   @default("CREATED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
